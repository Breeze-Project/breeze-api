root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{yml,yaml,toml}]
indent_size = 2

[*.md]
max_line_length = 80
trim_trailing_whitespace = false

[*.gradle.kts]
indent_size = 4
continuation_indent_size = 8
